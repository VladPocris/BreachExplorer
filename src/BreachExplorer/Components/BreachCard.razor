@using BreachExplorer.Models

<div class="breach-card-col col-lg-6 col-12">
    <div class="glass-card neon-border breach-card @(Breach.IsEnriched ? "" : "breach-card--limited")">
        <div class="breach-card__inner row g-3">
            <div class="col-sm-4 col-12 text-center breach-card__media">
                @if (Breach.IsEnriched && !string.IsNullOrEmpty(Breach.LogoPath))
                {
                    <img src="@Breach.LogoPath"
                         class="breach-card__logo img-fluid"
                         alt="@Breach.DisplayName logo" />
                }
                else
                {
                    <div class="breach-card__placeholder" aria-hidden="true">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                }

                @if (Breach.IsEnriched)
                {
                    @if (Breach.IsVerified)
                    {
                        <span class="badge-glass success breach-card__badge">
                            <i class="bi bi-patch-check me-1"></i>Verified
                        </span>
                    }
                    else
                    {
                        <span class="badge-glass danger breach-card__badge">
                            <i class="bi bi-exclamation-circle me-1"></i>Unverified
                        </span>
                    }
                }
                else
                {
                    <span class="badge-glass warning breach-card__badge">
                        <i class="bi bi-info-circle me-1"></i>Limited details
                    </span>
                }
            </div>

            <div class="col-sm-8 col-12 breach-card__body">
                <h3 class="breach-card__title gradient-header-alt">@Breach.DisplayName</h3>

                @if (!Breach.IsEnriched)
                {
                    <p class="breach-card__limited-note text-muted">
                        Found via LeakCheck. Full breach metadata is not available in Have I Been Pwned.
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Breach.Domain))
                {
                    <div class="breach-card__field">
                        <small class="text-muted">Domain</small>
                        <p>@Breach.Domain</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Breach.BreachDate))
                {
                    <div class="breach-card__field">
                        <small class="text-muted">Breach date</small>
                        <p class="breach-card__date">@Breach.BreachDate</p>
                    </div>
                }

                @if (Breach.IsEnriched && Breach.PwnCount > 0)
                {
                    <div class="breach-card__field">
                        <small class="text-muted">Records exposed</small>
                        <p class="breach-card__count">@Breach.PwnCount.ToString("N0")</p>
                    </div>
                }

                @if (Breach.IsEnriched && Breach.DataClasses?.Count > 0)
                {
                    <div class="breach-card__field">
                        <small class="text-muted">Data classes</small>
                        <div class="breach-card__tags">
                            @foreach (var dataClass in Breach.DataClasses.Take(6))
                            {
                                <span class="badge-glass">@dataClass</span>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Breach.Description))
                {
                    <div class="breach-card__description">
                        @((MarkupString)Breach.Description)
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EnrichedBreach Breach { get; set; } = null!;
}
