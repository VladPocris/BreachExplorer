@page "/"

<PageTitle>Breach Intelligence Dashboard</PageTitle>

@inject IAppConfigService AppConfigService
@using BreachExplorer.Components
@using BreachExplorer.Helpers
@using BreachExplorer.Constants

<div class="home-page">
    @if (!dataLoaded)
    {
        <div class="d-flex justify-content-center align-items-center loading-stage">
            <div class="spinner-glass loading-card">
                <div class="spinner-border spinner-border-cyan mb-3" role="img" aria-label="Loading" style="width: 60px; height: 60px; border-width: 4px;"></div>
                <p style="font-size: 1.2rem; margin-top: 20px;">Loading breach intelligence...</p>
            </div>
        </div>
    }
    else if (success)
    {
        @if (!string.IsNullOrWhiteSpace(errormessage))
        {
            <div class="alert-glass warning mb-4 status-banner">
                <i class="bi bi-exclamation-triangle me-2"></i>@errormessage
            </div>
        }

        @* Hero Section *@
        <div class="text-center mb-5 hero-stage">
            <h1 class="typewriter-heading">
                <span class="typewriter-text">Breach Intelligence Dashboard</span>
            </h1>
            <div class="section-divider"></div>
            <p class="home-page__tagline text-muted">Real-time security insights for your organization</p>
        </div>

        <div class="container-fluid home-page__content">
            <div class="row g-4 home-page__cards">
                <div class="col-12 col-lg-6">
                    <div class="glass-card neon-border panel-card dashboard-card">
                        <h3 class="dashboard-card__title gradient-header">
                            <i class="bi bi-exclamation-triangle me-2"></i>Latest Breach
                        </h3>
                        @if (latestBreach != null)
                        {
                            <div class="row g-3 dashboard-card__breach">
                                <div class="col-12 col-sm-4 text-center">
                                    <img src="@latestBreach.LogoPath" class="dashboard-card__logo img-fluid" alt="@latestBreach.Name" />
                                    @if (latestBreach.IsVerified)
                                    {
                                        <span class="badge-glass success" style="display: block;">Verified</span>
                                    }
                                </div>
                                <div class="col-12 col-sm-8">
                                    <h5 class="dashboard-card__name">@latestBreach.Name</h5>
                                    <div class="mb-2">
                                        <small class="text-muted">Records:</small>
                                        <p style="margin: 0; color: var(--accent-tertiary); font-weight: 700;">@latestBreach.PwnCount.ToString("N0")</p>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">Date:</small>
                                        <p style="margin: 0; color: var(--accent-primary);">@latestBreach.BreachDate</p>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">Description:</small>
                                        <p style="margin: 0; color: var(--text-primary);">@((MarkupString)latestBreach.Description)</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="glass-card neon-border panel-card dashboard-card">
                        <h3 class="dashboard-card__title gradient-header">
                            <i class="bi bi-key me-2"></i>Generate Password
                        </h3>

                        <div class="mb-4">
                            <label class="form-label" style="color: var(--accent-primary); font-weight: 600;">Length: <span class="badge-glass">@sliderValue</span></label>
                            <input type="range" class="form-range" min="1" max="64" step="1" @bind="@sliderValue" @oninput="UpdateTooltipValue" style="filter: hue-rotate(190deg);" />
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="numbers" @bind="@optionNumbers" />
                                <label class="form-check-label" for="numbers">Include Numbers</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="special" @bind="@optionCharacters" />
                                <label class="form-check-label" for="special">Include Special Characters</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <input class="form-control input-glass" type="text" placeholder="Generated password will appear here..." readonly @bind="@generatedPassword" id="passwordInput" />
                        </div>

                        <div class="dashboard-actions d-flex gap-2 flex-wrap">
                            <button class="btn btn-glass flex-grow-1" type="button" @onclick="UpdatePassword" disabled="@isGeneratingPassword">
                                @if (isGeneratingPassword)
                                {
                                    <span class="spinner-border spinner-border-sm spinner-border-cyan me-2"></span>
                                    <span>Generating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-stars me-2"></i><span>Generate</span>
                                }
                            </button>
                            <button class="btn btn-glass-secondary dashboard-actions__copy" type="button" @onclick="CopyTextToClipboard">
                                <i class="bi bi-copy me-2"></i>Copy
                            </button>
                        </div>
                        @if (showTooltip)
                        {
                            <div style="margin-top: 10px; padding: 10px; background: rgba(0,255,136,0.2); border-radius: 8px; border-left: 3px solid #00ff88;">
                                <small style="color: #00ff88;"><i class="bi bi-check-circle me-1"></i>Copied!</small>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <section class="chart-section">
                <h2 class="section-title gradient-header-alt">Top Data Breaches</h2>
                <div class="section-divider"></div>
                <p class="chart-section__hint text-muted text-center">Bar color: light blue = most records exposed, dark blue = fewest</p>

                <div class="glass-card neon-border panel-card chart-panel">
                    <div class="chart-shell">
                        <BarChart @ref="barChartTop" Height="@chartHeightTop" HeightUnit="Unit.Px" />
                    </div>
                    <div class="chart-legend" aria-hidden="true">
                        <span>Most exposed</span>
                        <span class="chart-legend__gradient"></span>
                        <span>Fewest exposed</span>
                    </div>
                </div>

                <div class="chart-toolbar">
                    <button class="btn btn-glass @(topChartHorizontal ? "active" : "")" @onclick="ShowHorizontalBarChartTopAsync">
                        <i class="bi bi-bar-chart me-2"></i>Horizontal
                    </button>
                    <button class="btn btn-glass @(!topChartHorizontal ? "active" : "")" @onclick="ShowVerticalBarChartTopAsync">
                        <i class="bi bi-graph-up me-2"></i>Vertical
                    </button>
                </div>
            </section>

            <section class="chart-section">
                <h2 class="section-title gradient-header">Compare Companies</h2>
                <div class="section-divider"></div>
                <p class="chart-section__hint text-muted text-center">Add companies to compare — light blue = most records stolen</p>

                <div class="glass-card neon-border panel-card chart-panel">
                    <div class="chart-shell">
                        <BarChart @ref="barChartCompare" Height="@chartHeightCompare" HeightUnit="Unit.Px" />
                    </div>
                    <div class="chart-legend" aria-hidden="true">
                        <span>Most exposed</span>
                        <span class="chart-legend__gradient"></span>
                        <span>Fewest exposed</span>
                    </div>
                </div>

                <div class="row g-3 chart-controls">
                    <div class="col-12 col-md-6">
                        <div style="display: flex; gap: 10px; position: relative; align-items: end;">
                            <div style="position: relative; min-width: 0; flex-grow: 1;">
                                <input type="text" class="form-control input-glass" placeholder="Search company..." @bind="@companyName" @oninput="OnCompanySearchInput" @onfocus="OnCompanySearchFocus" @onblur="OnCompanySearchBlur" @onkeydown="OnCompanySearchKeyDown" style="width: 100%;"/>
                                @if (showCompanySuggestions && filteredCompanies.Any())
                                {
                                    <div style="position: absolute; z-index: 9999; left: 0; right: 0; bottom: 100%; border: 1px solid rgba(176, 197, 228, 0.3); border-top: none; max-height: 200px; overflow-y: auto; background: rgba(12, 21, 39, 0.95); backdrop-filter: var(--blur-effect);">
                                        <div class="list-group list-group-flush">
                                            @foreach (var company in filteredCompanies.Take(8))
                                            {
                                                <div class="list-group-item list-group-item-action glass-card small" @onclick="() => SelectCompany(company.Name)" style="border-radius: 0; margin: 0; border-bottom: none;">
                                                    @company.Name
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-glass" @onclick="async () => await AddBarChartCompareAsync(companyName)">
                                <i class="bi bi-plus me-1"></i>Add
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-2">
                            <button class="btn btn-glass flex-grow-1" @onclick="async () => await RandomChartDataCompare()">
                                <i class="bi bi-dice me-2"></i>Random Companies
                            </button>
                            <button class="btn btn-glass-secondary" @onclick="async () => await CleanChartDataCompare()">
                                <i class="bi bi-trash me-2"></i>Clear
                            </button>
                        </div>
                    </div>
                </div>

                <div class="chart-toolbar">
                    <button class="btn btn-glass @(compareChartHorizontal ? "active" : "")" @onclick="ShowHorizontalBarChartCompareAsync">
                        <i class="bi bi-bar-chart me-2"></i>Horizontal
                    </button>
                    <button class="btn btn-glass @(!compareChartHorizontal ? "active" : "")" @onclick="ShowVerticalBarChartCompareAsync">
                        <i class="bi bi-graph-up me-2"></i>Vertical
                    </button>
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center error-stage">
            <div class="alert-glass danger error-card service-error-card">
                <h3 class="service-error-card__title">
                    <i class="bi bi-hourglass-split me-2"></i>@ServiceMessages.BackendUnavailableTitle
                </h3>
                <p class="service-error-card__lead">@ServiceMessages.BackendUnavailableLead</p>
                <p class="service-error-card__detail text-muted">@ServiceMessages.BackendUnavailableDetail</p>
                <button class="btn btn-glass-secondary" @onclick="async () => await ReloadDataAsync()">
                    <i class="bi bi-arrow-clockwise me-2"></i>Retry
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool success;
    private bool dataLoaded = false;
    private bool isGeneratingPassword = false;
    private string? errormessage;

    private int chartHeightTop = 420;
    private int chartHeightCompare = 320;
    private bool topChartHorizontal = true;
    private bool compareChartHorizontal = true;

    private BarChartDataset CreateStyledBarDataset(List<double?> data, string label)
    {
        var pointCount = Math.Max(data?.Count ?? 0, 1);
        var colors = ChartTheme.GenerateBlueGradientColors(data ?? new List<double?>());

        if (colors.Count < pointCount)
        {
            colors = Enumerable.Repeat("rgba(120, 217, 255, 0.75)", pointCount).ToList();
        }

        var borders = ChartTheme.GenerateBlueGradientBorders(colors);

        return new BarChartDataset
        {
            Label = label,
            Data = data ?? new List<double?>(),
            BackgroundColor = colors,
            BorderColor = borders,
            BorderWidth = Enumerable.Repeat(1.0, pointCount).ToList(),
            BorderRadius = Enumerable.Repeat(8.0, pointCount).ToList(),
            CategoryPercentage = 0.78,
            BarPercentage = 0.88,
            MaxBarThickness = 48
        };
    }

    private void UpdateChartHeights()
    {
        chartHeightTop = ChartTheme.GetChartHeight(GetDataTop().Count, topChartHorizontal);
        chartHeightCompare = ChartTheme.GetChartHeight(breachData.Count, compareChartHorizontal);
    }

        // Autocomplete functionality
        private bool showCompanySuggestions = false;
        private List<Breach> filteredCompanies = new List<Breach>();
        private int selectedIndex = -1;
    private bool chartsInitialized;

    protected override async Task OnInitializedAsync()
    {
        await ReloadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dataLoaded || !success || chartsInitialized)
        {
            return;
        }

        if (barChartTop is null || barChartCompare is null)
        {
            return;
        }

        try
        {
            await InitializeChartDataTop();
            await InitializeChartDataCompare();
            chartsInitialized = true;
        }
        catch (Exception ex)
        {
            success = false;
            errormessage = $"Error loading data: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ReloadDataAsync()
    {
        try
        {
            Console.WriteLine("ReloadDataAsync: Starting data load");
            dataLoaded = false;
            success = true;
            errormessage = null;
            chartsInitialized = false;
            StateHasChanged();

            var warnings = new List<string>();

            var breachWarning = await GetBreachAsync();
            if (!string.IsNullOrWhiteSpace(breachWarning))
            {
                warnings.Add(breachWarning);
            }

            var breachesWarning = await GetBreachesAsync();
            if (!string.IsNullOrWhiteSpace(breachesWarning))
            {
                warnings.Add(breachesWarning);
            }

            Console.WriteLine($"ReloadDataAsync: breachesList count after loading: {breachesList.Count}");
            success = breachesList.Count > 0;
            errormessage = success
                ? string.Join(" ", warnings)
                : warnings.Count > 0
                    ? $"Error loading data: {string.Join(" ", warnings)}"
                    : "Error loading data: no breach data was returned.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ReloadDataAsync: Exception: {ex.Message}");
            success = false;
            errormessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            dataLoaded = true;
            Console.WriteLine("ReloadDataAsync: Finished data load");
            StateHasChanged();
        }
    }

    private Breach? latestBreach;
    private List<Breach> breachesList = new List<Breach>();

    private string GetBackendApiBaseUrl()
    {
        return AppConfigService.GetBackendApiUrl().TrimEnd('/');
    }

    private async Task<string?> GetBreachAsync()
    {
        try
        {
            string uri = $"{GetBackendApiBaseUrl()}/api/Breaches/latestbreach";
            latestBreach = await Http.GetFromJsonAsync<Breach>(uri);
            return latestBreach is null ? "Latest breach response was empty." : null;
        }
        catch (Exception e)
        {
            latestBreach = null;
            return e.Message;
        }
    }

    private async Task<string?> GetBreachesAsync()
    {
        try
        {
            string uri = $"{GetBackendApiBaseUrl()}/api/Breaches/breaches";
            breachesList = await Http.GetFromJsonAsync<List<Breach>>(uri) ?? new List<Breach>();
            return breachesList.Count == 0 ? "Breach list response was empty." : null;
        }
        catch (Exception e)
        {
            breachesList = new List<Breach>();
            return e.Message;
        }
    }

    public class Breach
    {
        public string? Name { get; set; }
        public string? Title { get; set; }
        public string? Domain { get; set; }
        public string? BreachDate { get; set; }
        public DateTime AddedDate { get; set; }
        public DateTime ModifiedDate { get; set; }
        public int PwnCount { get; set; }
        public string? Description { get; set; }
        public string? LogoPath { get; set; }
        public List<string>? DataClasses { get; set; }
        public bool IsVerified { get; set; }
        public bool IsFabricated { get; set; }
        public bool IsSensitive { get; set; }
        public bool IsRetired { get; set; }
        public bool IsSpamList { get; set; }
        public bool IsMalware { get; set; }
        public bool IsSubscriptionFree { get; set; }
    }

    private Password? password;
    private string? generatedPassword;
    private bool optionNumbers = true;
    private bool optionCharacters = true;

    private async Task GetPasswordAsync()
    {
        isGeneratingPassword = true;
        StateHasChanged();

        try
        {
            string backendUrl = GetBackendApiBaseUrl();
            string uri =
                $"{backendUrl}/api/Breaches/generate-password?length="
                + sliderValue
                + "&includeNumbers=" + optionNumbers
                + "&includeSpecialChars=" + optionCharacters;

            var response = await Http.GetAsync(uri);
            var body = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                string msg;
                try
                {
                    using var doc = JsonDocument.Parse(body);
                    msg = doc.RootElement.GetProperty("error").GetString() ?? body;
                }
                catch
                {
                    msg = body;
                }

                if (!optionNumbers || !optionCharacters)
                {
                    var missingFeatures = new List<string>();
                    if (!optionNumbers)
                        missingFeatures.Add("numbers");
                    if (!optionCharacters)
                        missingFeatures.Add("special characters");

                    msg = $"Cannot generate without {string.Join(" and ", missingFeatures)}";
                }

                errormessage = msg;
                ToastService.Notify(new(ToastType.Warning, msg));
                return;
            }

            password = JsonSerializer.Deserialize<Password>(body);
            errormessage = String.Empty;
            generatedPassword = password!.random_password;
        }
        catch (Exception e)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error: {e.Message}"));
        }
        finally
        {
            isGeneratingPassword = false;
            StateHasChanged();
        }
    }

    public class Password
    {
        public string? random_password { get; set; }
    }

    public async Task UpdatePassword()
    {
        await GetPasswordAsync();
        StateHasChanged();
    }

    private int sliderValue = 16;
    private bool showTooltip = false;

    private void UpdateTooltipValue(ChangeEventArgs e)
    {
        sliderValue = int.Parse(e.Value.ToString());
    }

    private async Task CopyTextToClipboard()
    {
        if (!string.IsNullOrWhiteSpace(generatedPassword))
        {
            await JS.InvokeVoidAsync("copyToClipboard", generatedPassword);
            showTooltip = true;
            StateHasChanged();
            await Task.Delay(2000);
            showTooltip = false;
            StateHasChanged();
        }
    }

    private BarChart barChartTop = default!;
    private BarChartOptions barChartOptionsTop = default!;
    private ChartData chartDataTop = default!;

    private List<string?> GetLabelsTop()
    {
        var topBreaches = breachesList.OrderByDescending(b => b.PwnCount).Take(10).ToList();
        return topBreaches.Select(b => b.Name).ToList();
    }

    private List<double?> GetDataTop()
    {
        var topBreaches = breachesList.OrderByDescending(b => b.PwnCount).Take(10).ToList();
        return topBreaches.Select(b => (double?)b.PwnCount).ToList();
    }

    private async Task InitializeChartDataTop()
    {
        if (barChartTop is null)
        {
            return;
        }

        var data = GetDataTop();
        if (data.Count == 0)
        {
            return;
        }

        topChartHorizontal = true;
        UpdateChartHeights();

        chartDataTop = new ChartData
        {
            Labels = GetLabelsTop(),
            Datasets = new List<IChartDataset> { CreateStyledBarDataset(data, "Records exposed") }
        };

        barChartOptionsTop = new BarChartOptions();
        ChartTheme.SetAxisOrientation(barChartOptionsTop, topChartHorizontal);

        await barChartTop.InitializeAsync(chartDataTop, barChartOptionsTop);
    }

    protected async Task ShowHorizontalBarChartTopAsync()
    {
        topChartHorizontal = true;
        UpdateChartHeights();
        ChartTheme.SetAxisOrientation(barChartOptionsTop, true);
        await barChartTop.UpdateAsync(chartDataTop, barChartOptionsTop);
        StateHasChanged();
    }

    protected async Task ShowVerticalBarChartTopAsync()
    {
        topChartHorizontal = false;
        UpdateChartHeights();
        ChartTheme.SetAxisOrientation(barChartOptionsTop, false);
        await barChartTop.UpdateAsync(chartDataTop, barChartOptionsTop);
        StateHasChanged();
    }

    [Inject] protected ToastService ToastService { get; set; } = default!;
    private string? companyName;
    private BarChart barChartCompare = default!;
    private BarChartOptions barChartOptionsCompare = default!;
    private ChartData chartDataCompare = default!;
    private List<Breach> breachData = new List<Breach>();

    private List<string?> GetLabelsCompare(List<Breach> data)
    {
        var selectedBreaches = data.OrderByDescending(b => b.PwnCount).ToList();
        return selectedBreaches.Select(b => (string?)b.Name).ToList();
    }

    private List<double?> GetDataCompare(List<Breach> data)
    {
        var selectedBreaches = data.OrderByDescending(b => b.PwnCount).ToList();
        return selectedBreaches.Select(b => (double?)b.PwnCount).ToList();
    }

    protected async Task AddBarChartCompareAsync(string querry)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(companyName))
            {
                ToastService.Notify(new(ToastType.Info, "Enter a company name."));
            }
            else if (breachData.Count == 15)
            {
                ToastService.Notify(new(ToastType.Danger, "Maximum 15 companies. Remove one first."));
            }
            else
            {
                var temp = breachesList.Where(breach => breach.Name?.ToUpper() == querry?.ToUpper()).ToList();

                if (temp.Count <= 0)
                {
                    ToastService.Notify(new(ToastType.Warning, "Company not found."));
                }
                else
                {
                    foreach (var breach in temp)
                        breachData.Add(breach);

                    var data = GetDataCompare(breachData);
                    UpdateChartHeights();
                    chartDataCompare = new ChartData
                    {
                        Labels = GetLabelsCompare(breachData),
                        Datasets = new List<IChartDataset> { CreateStyledBarDataset(data, "Records exposed") }
                    };
                    await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
                    StateHasChanged();
                }
            }
        }
        catch (Exception e)
        {
            ToastService.Notify(new(ToastType.Danger, e.Message));
        }
    }

    protected async Task RemoveBarChartCompareAsync(string? querry)
    {
        if (string.IsNullOrWhiteSpace(companyName))
        {
            ToastService.Notify(new(ToastType.Info, "Enter a company name."));
        }
        else
        {
            var temp = breachData.Where(breach => breach.Name?.ToUpper() == querry?.ToUpper()).ToList();

            if (temp.Count <= 0)
            {
                ToastService.Notify(new(ToastType.Warning, "Not found."));
            }
            else
            {
                breachData.Remove(temp[0]);

                var data = GetDataCompare(breachData);
                UpdateChartHeights();
                chartDataCompare = new ChartData
                {
                    Labels = GetLabelsCompare(breachData),
                    Datasets = new List<IChartDataset> { CreateStyledBarDataset(data, "Records exposed") }
                };
                await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
                StateHasChanged();
            }
        }
    }

    private async Task CleanChartDataCompare()
    {
        breachData = new List<Breach>();

        var data = new List<double?>();
        UpdateChartHeights();
        chartDataCompare = new ChartData
        {
            Labels = new List<string?>(),
            Datasets = new List<IChartDataset> { CreateStyledBarDataset(data, "Records exposed") }
        };
        await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
        StateHasChanged();
    }

    private async Task RandomChartDataCompare()
    {
        var random = new Random();
        breachData = breachesList.Where(breach => breach.PwnCount > 5000000).OrderBy(b => random.Next()).Take(8).ToList();

        // Generate gradient colors based on current data
        var data = GetDataCompare(breachData);
        UpdateChartHeights();
        chartDataCompare = new ChartData
        {
            Labels = GetLabelsCompare(breachData),
            Datasets = new List<IChartDataset> { CreateStyledBarDataset(data, "Records exposed") }
        };
        await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
        StateHasChanged();
    }

    private async Task InitializeChartDataCompare()
    {
        if (barChartCompare is null)
        {
            return;
        }

        compareChartHorizontal = true;
        UpdateChartHeights();

        chartDataCompare = new ChartData
        {
            Labels = new List<string?>(),
            Datasets = new List<IChartDataset> { CreateStyledBarDataset(new List<double?>(), "Records exposed") }
        };

        barChartOptionsCompare = new BarChartOptions();
        ChartTheme.SetAxisOrientation(barChartOptionsCompare, compareChartHorizontal);

        await barChartCompare.InitializeAsync(chartDataCompare, barChartOptionsCompare);
    }

    protected async Task ShowHorizontalBarChartCompareAsync()
    {
        compareChartHorizontal = true;
        UpdateChartHeights();
        ChartTheme.SetAxisOrientation(barChartOptionsCompare, true);
        await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
        StateHasChanged();
    }

    protected async Task ShowVerticalBarChartCompareAsync()
    {
        compareChartHorizontal = false;
        UpdateChartHeights();
        ChartTheme.SetAxisOrientation(barChartOptionsCompare, false);
        await barChartCompare.UpdateAsync(chartDataCompare, barChartOptionsCompare);
        StateHasChanged();
    }

    private void OnCompanySearchFocus(FocusEventArgs e)
    {
        // When input gets focus, show suggestions
        if (breachesList.Count == 0)
        {
            // Data not loaded yet or empty
            showCompanySuggestions = false;
        }
        else if (string.IsNullOrWhiteSpace(companyName))
        {
            // Show all companies when focused and empty
            filteredCompanies = breachesList.OrderBy(b => b.Name).ToList();
            showCompanySuggestions = filteredCompanies.Any();
            selectedIndex = -1;
        }
        else
        {
            // Show filtered results when focused and has text
            var searchTerm = companyName.Trim().ToUpper();
            filteredCompanies = breachesList
                .Where(b => b.Name != null && b.Name.ToUpper().Contains(searchTerm))
                .OrderBy(b => b.Name)
                .ToList();

            showCompanySuggestions = filteredCompanies.Any();
            selectedIndex = -1;
        }

        // Ensure UI updates
        StateHasChanged();
    }

    private async void OnCompanySearchBlur(FocusEventArgs e)
    {
        // Hide suggestions when input loses focus
        // Delay slightly to allow click events on suggestions to fire
        await Task.Delay(200);
        // Always hide suggestions on blur - this ensures input is accessible again
        showCompanySuggestions = false;
        StateHasChanged();
    }

    private void OnCompanySearchInput(ChangeEventArgs e)
    {
        // Use the event value for immediate response to typing
        string? value = e.Value?.ToString();
        companyName = value; // Update the bound field to keep it in sync

        if (string.IsNullOrWhiteSpace(value))
        {
            filteredCompanies = new List<Breach>();
            showCompanySuggestions = false;
            return;
        }

        var searchTerm = value.Trim().ToUpper();
        filteredCompanies = breachesList
            .Where(b => b.Name != null && b.Name.ToUpper().Contains(searchTerm))
            .OrderBy(b => b.Name)
            .ToList();

        showCompanySuggestions = filteredCompanies.Any();
        selectedIndex = -1;
        StateHasChanged();
    }

    private void OnCompanySearchKeyDown(KeyboardEventArgs e)
    {
        if (!showCompanySuggestions || !filteredCompanies.Any())
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                selectedIndex = (selectedIndex + 1) % filteredCompanies.Count;
                break;
            case "ArrowUp":
                selectedIndex = (selectedIndex - 1 + filteredCompanies.Count) % filteredCompanies.Count;
                break;
            case "Enter":
                if (selectedIndex >= 0 && selectedIndex < filteredCompanies.Count)
                {
                    SelectCompany(filteredCompanies[selectedIndex].Name);
                }
                else if (!string.IsNullOrWhiteSpace(companyName))
                {
                    SelectCompany(companyName);
                }
                break;
            case "Escape":
                showCompanySuggestions = false;
                break;
        }
    }

    private void SelectCompany(string company)
    {
        companyName = company;
        showCompanySuggestions = false;
        _ = AddBarChartCompareAsync(companyName);
    }
}