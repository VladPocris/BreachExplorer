@page "/Breached"

<PageTitle>Was I Breached?</PageTitle>

@inject IAppConfigService AppConfigService
@using BreachExplorer.Components
@using BreachExplorer.Models
@using BreachExplorer.Constants

<div class="breached-page">
    <div class="breached-page__hero text-center">
        <h1 class="section-title gradient-header">Check Your Email</h1>
        <p class="breached-page__subtitle text-muted">
            Search LeakCheck sources, enriched with Have I Been Pwned breach intelligence
        </p>
    </div>

    <div class="breached-page__search">
        <div class="glass-card neon-border breached-page__search-card">
            <div class="breached-page__form">
                <input class="form-control input-glass breached-page__input"
                       type="email"
                       placeholder="Enter your email address..."
                       @bind="emailAddress"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
                <button class="btn btn-glass breached-page__button"
                        type="button"
                        @onclick="CheckEmailAsync"
                        disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm spinner-border-cyan me-2" role="status" aria-hidden="true"></span>
                        <span>Checking...</span>
                    }
                    else
                    {
                        <i class="bi bi-search me-2"></i>
                        <span>Check Email</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!success && hasSearched)
    {
        <div class="breached-page__status">
            <div class="alert-glass danger breached-page__alert" role="alert">
                @if (showServiceWakeupMessage)
                {
                    <h3 class="breached-page__alert-title">
                        <i class="bi bi-hourglass-split me-2"></i>@ServiceMessages.BackendUnavailableTitle
                    </h3>
                    <p class="breached-page__alert-lead">@ServiceMessages.BackendUnavailableLead</p>
                    <p class="breached-page__alert-detail text-muted mb-3">@ServiceMessages.BackendUnavailableDetail</p>
                }
                else
                {
                    <h3 class="breached-page__alert-title">
                        <i class="bi bi-exclamation-octagon me-2"></i>Error
                    </h3>
                    <p class="mb-3">@errorMessage</p>
                }
                <button class="btn btn-glass-secondary" @onclick="ResetSearch">Try Again</button>
            </div>
        </div>
    }

    @if (breaches.Count > 0 && success && hasSearched)
    {
        <div class="breached-page__results">
            <div class="text-center mb-4">
                <h2 class="breached-page__results-title">
                    <i class="bi bi-shield-exclamation me-2"></i>
                    @totalFound Breach@(totalFound == 1 ? "" : "es") Found
                </h2>
                <p class="text-muted">
                    Showing @breaches.Count unique source@(breaches.Count == 1 ? "" : "s")
                    @if (totalFound > breaches.Count)
                    {
                        <span> (of @totalFound total hits)</span>
                    }
                </p>
            </div>

            <div class="row g-4 breached-page__grid">
                @foreach (var breach in breaches)
                {
                    <BreachCard Breach="breach" />
                }
            </div>
        </div>
    }

    @if (breaches.Count == 0 && hasSearched && success)
    {
        <div class="breached-page__status">
            <div class="alert-glass success breached-page__alert breached-page__alert--center">
                <h2 class="breached-page__safe-title">
                    <i class="bi bi-check-circle me-2"></i>You're Safe!
                </h2>
                <p class="mb-0">Your email was not found in any known data breaches.</p>
            </div>
        </div>
    }
</div>

@code {
    private string errorMessage = string.Empty;
    private bool showServiceWakeupMessage;
    private bool success = true;
    private bool isLoading;
    private bool hasSearched;
    private string emailAddress = string.Empty;
    private int totalFound;
    private List<EnrichedBreach> breaches = new();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading)
        {
            await CheckEmailAsync();
        }
    }

    private void ResetSearch()
    {
        success = true;
        hasSearched = false;
        showServiceWakeupMessage = false;
        errorMessage = string.Empty;
        breaches.Clear();
    }

    private async Task CheckEmailAsync()
    {
        try
        {
            isLoading = true;
            success = true;
            showServiceWakeupMessage = false;
            errorMessage = string.Empty;
            hasSearched = false;
            breaches.Clear();
            totalFound = 0;
            StateHasChanged();

            if (string.IsNullOrWhiteSpace(emailAddress))
            {
                success = false;
                errorMessage = "Please enter an email address.";
                hasSearched = true;
                return;
            }

            if (!IsValidEmail(emailAddress))
            {
                success = false;
                errorMessage = "Please enter a valid email format.";
                hasSearched = true;
                return;
            }

            var backendUrl = AppConfigService.GetBackendApiUrl();
            var uri = $"{backendUrl}/api/Breaches/check/{Uri.EscapeDataString(emailAddress.Trim())}";

            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            var response = await Http.GetAsync(uri, cts.Token);

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                breaches = new List<EnrichedBreach>();
                success = true;
                hasSearched = true;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                success = false;
                showServiceWakeupMessage = IsLikelyBackendSleeping(response.StatusCode);
                errorMessage = showServiceWakeupMessage
                    ? string.Empty
                    : response.StatusCode switch
                    {
                        System.Net.HttpStatusCode.BadRequest => "Invalid email format.",
                        System.Net.HttpStatusCode.Unauthorized => "API key invalid or expired.",
                        System.Net.HttpStatusCode.Forbidden => "Breach API access is currently restricted.",
                        _ => $"Error (status {(int)response.StatusCode}). Please try again."
                    };
                hasSearched = true;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<EmailBreachCheckResult>();
            breaches = result?.Breaches ?? new List<EnrichedBreach>();
            totalFound = result?.TotalFound ?? breaches.Count;
            success = true;
            hasSearched = true;
        }
        catch (TaskCanceledException)
        {
            success = false;
            showServiceWakeupMessage = true;
            errorMessage = string.Empty;
            hasSearched = true;
        }
        catch (HttpRequestException)
        {
            success = false;
            showServiceWakeupMessage = true;
            errorMessage = string.Empty;
            hasSearched = true;
        }
        catch (Exception)
        {
            success = false;
            errorMessage = "An unexpected error occurred.";
            hasSearched = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static bool IsValidEmail(string email)
    {
        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return System.Text.RegularExpressions.Regex.IsMatch(email, emailPattern);
    }

    private static bool IsLikelyBackendSleeping(System.Net.HttpStatusCode statusCode) =>
        statusCode is System.Net.HttpStatusCode.BadGateway
            or System.Net.HttpStatusCode.ServiceUnavailable
            or System.Net.HttpStatusCode.GatewayTimeout
            or System.Net.HttpStatusCode.RequestTimeout;
}
